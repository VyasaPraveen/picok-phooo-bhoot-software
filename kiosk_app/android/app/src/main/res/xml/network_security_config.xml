<?xml version="1.0" encoding="utf-8"?>
<!-- The EPIXS Print Bridge runs on the booth's local network over plain HTTP (paired with a key).
     Internet services (payments via the bridge, template cloud) use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
