{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.val() === true && auth.token.email === 'praveenkrishna548@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.val() === true"
      }
    },
    "adminProfiles": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && (auth.uid === $uid || !newData.exists())",
        ".validate": "newData.hasChildren(['email']) && newData.child('email').val() === auth.token.email",
        "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other": { ".validate": false }
      }
    },
    "adminRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && auth.provider === 'password') || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['email', 'createdAt'])",
        "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "pairing": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$code": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && !newData.exists()))",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.hasChildren(['uid', 'role', 'createdAt'])",
        "uid": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "role": { ".validate": "newData.val() === 'kiosk' || newData.val() === 'bridge'" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "booths": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$b": {
        ".read": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b",
        "state": {
          ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b && root.child('devices').child(auth.uid).child('role').val() === 'kiosk' && newData.exists()",
          "printsRemaining": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
        },
        "counters": {
          "$day": {
            ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b && root.child('devices').child(auth.uid).child('role').val() === 'kiosk' && newData.isNumber() && (!data.exists() || newData.val() > data.val())"
          }
        },
        "orders": {
          ".indexOn": ["createdAt"],
          "$o": {
            ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b && root.child('devices').child(auth.uid).child('role').val() === 'kiosk' && newData.exists() && (!data.exists() || (newData.child('createdAt').val() === data.child('createdAt').val() && !data.child('refundedAt').exists()))",
            ".validate": "newData.hasChildren(['id', 'amount', 'status', 'createdAt']) && newData.child('id').val() === $o",
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "copies": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" }
          }
        },
        "payments": {
          ".indexOn": ["state"],
          "$o": {
            ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b",
            "state": {
              ".validate": "((root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true) && (data.val() !== 'cancel' || newData.val() === 'cancel' || newData.val() === 'closed' || newData.val() === 'paid' || newData.val() === 'expired')) || (newData.val() === 'requested' && !data.exists()) || (newData.val() === 'cancel' && (data.val() === 'requested' || data.val() === 'pending' || data.val() === 'error' || data.val() === 'cancel'))"
            },
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "paymentId": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "payerVpa": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "qrId": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "upiString": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "imagePng": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "expiresAt": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" },
            "message": { ".validate": "root.child('devices').child(auth.uid).child('role').val() === 'bridge' || root.child('admins').child(auth.uid).val() === true" }
          }
        },
        "jobs": {
          ".indexOn": ["status"],
          "$j": {
            ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b",
            "data": { ".validate": "newData.isString() && newData.val().length <= 10000000" }
          }
        },
        "testPrints": {
          ".indexOn": ["status"],
          "$t": {
            ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b && root.child('devices').child(auth.uid).child('role').val() === 'bridge'"
          }
        },
        "bridge": {
          ".write": "auth != null && root.child('devices').child(auth.uid).child('boothId').val() === $b && root.child('devices').child(auth.uid).child('role').val() === 'bridge'",
          "publicKey": {
            ".validate": "newData.isString() && newData.val().length <= 2000 && (!data.exists() || data.val() === newData.val() || root.child('admins').child(auth.uid).val() === true)"
          }
        }
      }
    }
  }
}
